rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /negocios/{negocioId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && resource.data.propietarioId
                               == request.auth.uid;
    }

    match /negocios/{negocioId}/productos/{productoId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && get(
                         /databases/$(database)/documents/negocios/$(negocioId)
                       ).data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && get(
                                 /databases/$(database)/documents/negocios/$(negocioId)
                               ).data.propietarioId
                               == request.auth.uid;
    }

    match /pedidos/{pedidoId} {

      // CLIENTE: puede crear su propio pedido
      allow create: if request.auth != null
                    && request.resource.data.usuarioId
                       == request.auth.uid;


      // CLIENTE:
      // puede leer sus pedidos.
      //
      // NEGOCIO:
      // puede leer pedidos de su propio negocio.
      allow read: if request.auth != null
                  && (
                    resource.data.usuarioId
                    == request.auth.uid

                    ||

                    (
                      resource.data.negocioId != null
                      && get(
                           /databases/$(database)/documents/negocios/$(resource.data.negocioId)
                         ).data.propietarioId
                         == request.auth.uid
                    )
                  );


      // NEGOCIO:
      // solamente el propietario del negocio puede cambiar
      // el estado de sus pedidos.
      allow update: if request.auth != null

                    && resource.data.negocioId != null

                    && get(
                         /databases/$(database)/documents/negocios/$(resource.data.negocioId)
                       ).data.propietarioId
                       == request.auth.uid

                    // El negocio solamente puede modificar
                    // estado y fechaActualizacion.
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         "estado",
                         "fechaActualizacion"
                       ])

                    // Transiciones permitidas.
                    && (

                      // Pendiente -> aceptado
                      (
                        resource.data.estado == "pendiente"
                        && request.resource.data.estado == "aceptado"
                      )

                      ||

                      // Pendiente -> cancelado
                      (
                        resource.data.estado == "pendiente"
                        && request.resource.data.estado == "cancelado"
                      )

                      ||

                      // Aceptado -> preparando
                      (
                        resource.data.estado == "aceptado"
                        && request.resource.data.estado == "preparando"
                      )

                      ||

                      // Preparando -> listo
                      (
                        resource.data.estado == "preparando"
                        && request.resource.data.estado == "listo"
                      )

                      ||

                      // Listo -> en_camino
                      (
                        resource.data.estado == "listo"
                        && request.resource.data.estado == "en_camino"
                      )

                      ||

                      // En camino -> entregado
                      (
                        resource.data.estado == "en_camino"
                        && request.resource.data.estado == "entregado"
                      )
                    );


      // No permitimos borrar pedidos.
      allow delete: if false;
    }
  }
}
