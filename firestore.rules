rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /*
     * ==============================
     * USUARIOS
     * ==============================
     */

    match /usuarios/{userId} {

      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }


    /*
     * ==============================
     * NEGOCIOS
     * ==============================
     */

    match /negocios/{negocioId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && resource.data.propietarioId
                               == request.auth.uid;
    }


    /*
     * ==============================
     * PRODUCTOS
     * ==============================
     */

    match /negocios/{negocioId}/productos/{productoId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && get(
                         /databases/$(database)/documents/negocios/$(negocioId)
                       ).data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && get(
                                 /databases/$(database)/documents/negocios/$(negocioId)
                               ).data.propietarioId
                               == request.auth.uid;
    }


    /*
     * ==============================
     * PEDIDOS
     * ==============================
     */

    match /pedidos/{pedidoId} {

      /*
       * El cliente solamente puede crear
       * pedidos a su propio nombre.
       */
      allow create: if request.auth != null
                    && request.resource.data.usuarioId
                       == request.auth.uid;


      /*
       * El cliente puede leer sus propios pedidos.
       *
       * El propietario del negocio puede leer
       * los pedidos realizados a su negocio.
       */
      allow read: if request.auth != null
                  && (
                    resource.data.usuarioId
                    == request.auth.uid

                    ||

                    get(
                      /databases/$(database)/documents/negocios/$(resource.data.negocioId)
                    ).data.propietarioId
                    == request.auth.uid
                  );


      /*
       * Los pedidos no pueden ser modificados
       * ni eliminados directamente por el cliente.
       */
      allow update, delete: if false;
    }

  }

}
