rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // =========================================================
    // DOCUMENTOS PRIVADOS DE DELIVERY
    // =========================================================
    //
    // El Delivery puede SUBIR sus documentos.
    // Nadie puede leerlos directamente desde la aplicación.
    //
    match /delivery_privado/{uid}/{documento=**} {

      allow read: if false;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }


    // =========================================================
    // FOTOS NORMALES DEL USUARIO
    // =========================================================
    //
    // Mantiene el funcionamiento actual de las fotos de perfil.
    //
    match /usuarios/{uid}/{archivo=**} {

      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }


    // =========================================================
    // IMÁGENES DE NEGOCIOS
    // =========================================================
    //
    // Cualquier usuario autenticado puede VER imágenes.
    // SOLO el propietario del negocio puede subir, modificar
    // o eliminar imágenes de ese negocio.
    //
    match /negocios/{negocioId}/{archivo=**} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && firestore.get(
                        /databases/(default)/documents/negocios/$(negocioId)
                      ).data.propietarioId
                      == request.auth.uid;
    }


    // =========================================================
    // TODO LO DEMÁS BLOQUEADO
    // =========================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
