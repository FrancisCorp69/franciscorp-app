                  Agregar una referencia
                </Text>

                <Text style={styles.optionSubtitle}>
                  Ejemplo: casa de color blanco, junto al parque.
                </Text>
              </View>

              <MaterialCommunityIcons
                name="chevron-right"
                size={25}
                color="#777"
              />
            </Pressable>
          </View>

          {/* MÉTODO DE PAGO */}
