import * as ExpoRouter from "expo-router";
import { Text, View } from "react-native";
import { CartProvider } from "../context/CartContext";
import AuthProvider from "../components/AuthProvider";

console.log("=== DIAGNOSTICO REAL EXPO ROUTER ===");
console.log("Stack:", typeof ExpoRouter.Stack);
console.log("Navigator:", typeof ExpoRouter.Navigator);
console.log("Slot:", typeof ExpoRouter.Slot);
console.log("withLayoutContext:", typeof ExpoRouter.withLayoutContext);
console.log("StackRouter:", typeof ExpoRouter.StackRouter);
console.log("useRouter:", typeof ExpoRouter.useRouter);
console.log("ExpoRouter keys:", Object.keys(ExpoRouter).filter((k) => k.toLowerCase().includes("stack")));

export default function Layout() {
  console.log("=== RENDER ROOT LAYOUT ===");
  console.log("Stack al renderizar:", typeof ExpoRouter.Stack);

  if (typeof ExpoRouter.Stack !== "function") {
    return (
      <View>
        <Text>ERROR: ExpoRouter.Stack no esta disponible</Text>
      </View>
    );
  }

  return (
    <AuthProvider>
      <CartProvider>
        <ExpoRouter.Stack />
      </CartProvider>
    </AuthProvider>
  );
}
