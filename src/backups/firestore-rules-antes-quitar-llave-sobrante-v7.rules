rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES DE SEGURIDAD
    // =========================================================

    function esPropietario(userId) {
      return request.auth != null
             && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
             && request.auth.token.admin == true;
    }

    function tieneDeliveryEnSolicitud() {
      return request.resource.data.keys().hasAny(["delivery"])
             &&
             request.resource.data.delivery.keys().hasAll([
               "estadoVerificacion",
               "estado",
               "activo",
               "disponible"
             ]);
    }

    function deliveryEnSolicitudSegura() {
      return tieneDeliveryEnSolicitud()
             &&
             request.resource.data.delivery.estadoVerificacion
               == "pendiente"
             &&
             request.resource.data.delivery.estado
               == "en_revision"
             &&
             request.resource.data.delivery.activo
               == false
             &&
             request.resource.data.delivery.disponible
               == false;
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /usuarios/{userId} {

      // -------------------------------------------------------
      // LECTURA
      // -------------------------------------------------------

      allow read: if isAdmin()
            ||
            esPropietario(userId)
            ||
            (
              resource.data.keys().hasAny(["roles"])
              &&
              resource.data.roles.Delivery == true
              &&
              resource.data.keys().hasAny(["delivery"])
              &&
              resource.data.delivery.estadoVerificacion == "aprobado"
              &&
              resource.data.delivery.activo == true
              &&
              resource.data.delivery.disponible == true
            );


      // -------------------------------------------------------
      // CREACIÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“N
      // -------------------------------------------------------
      //
      // El usuario puede crear su propio perfil.
      //
      // Si incluye Delivery desde el comienzo, ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Âºnicamente
      // puede crearlo como solicitud pendiente y en revisiÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â³n.
      //

      allow create: if esPropietario(userId)
                    &&
                    (
                      !request.resource.data.keys().hasAny(["delivery"])
                      ||
                      deliveryEnSolicitudSegura()
                    );


      // -------------------------------------------------------
      // ACTUALIZACIÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“N
      // -------------------------------------------------------

      allow update: if esPropietario(userId)
                    &&
                    (

                      // -----------------------------------------
                      // 1. PERFIL NORMAL SIN BLOQUE DELIVERY
                      // -----------------------------------------
                      //
                      // Si el documento resultante no contiene
                      // Delivery, permitimos actualizar el perfil.
                      //
                      !request.resource.data.keys().hasAny(["delivery"])


                      ||


                      // -----------------------------------------
                      // 2. CREAR / COMPLETAR SOLICITUD DELIVERY
                      // -----------------------------------------
                      //
                      // Mientras no estÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â© aprobado, el usuario
                      // puede completar su solicitud, pero jamÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¡s
                      // puede activarla.
                      //
                      (
                        (
                          !resource.data.keys().hasAny(["delivery"])
                          ||
                          !resource.data.delivery.keys().hasAny([
                            "estadoVerificacion"
                          ])
                          ||
                          (
                            resource.data.delivery.keys().hasAny([
                              "estadoVerificacion"
                            ])
                            &&
                            resource.data.delivery.estadoVerificacion
                              == "pendiente"
                          )
                          ||
                          (
                            resource.data.delivery.keys().hasAny([
                              "estadoVerificacion"
                            ])
                            &&
                            resource.data.delivery.estadoVerificacion
                              == "rechazado"
                          )
                        )
                        &&
                        deliveryEnSolicitudSegura()
                      )


                      ||


                      // -----------------------------------------
                      // 3. DELIVERY YA APROBADO
                      // -----------------------------------------
                      //
                      // Una vez aprobado, el usuario NO puede
                      // modificar el bloque Delivery.
                      //
                      (
                        resource.data.keys().hasAny(["delivery"])
                        &&
                        resource.data.delivery.keys().hasAny([
                          "estadoVerificacion"
                        ])
                        &&
                        resource.data.delivery.estadoVerificacion
                          == "aprobado"
                        &&
                        request.resource.data.keys().hasAny(["delivery"])
                        &&
                        request.resource.data.delivery.keys().hasAll([
                          "estadoVerificacion",
                          "estado",
                          "activo",
                          "disponible"
                        ])
                        &&
                        request.resource.data.delivery.estadoVerificacion
                          == resource.data.delivery.estadoVerificacion
                        &&
                        request.resource.data.delivery.estado
                          == resource.data.delivery.estado
                        &&
                        request.resource.data.delivery.activo
                          == resource.data.delivery.activo
                        &&
                        request.resource.data.delivery.disponible
                          == resource.data.delivery.disponible
                        &&
                        request.resource.data.delivery.solicitud
                          == resource.data.delivery.solicitud
                        &&
                        request.resource.data.delivery.diff(
                          resource.data.delivery
                        ).affectedKeys().hasOnly([
                          "tipoVehiculo",
                          "marca",
                          "modelo",
                          "anio",
                          "color",
                          "placa",
                          "zonaTrabajo",
                          "documentos"
                        ])
                      )
                    );


      // -------------------------------------------------------
      // ELIMINACIÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã¢â‚¬Å“N
      // -------------------------------------------------------

      allow delete: if false;
    }


    // =========================================================
    // NEGOCIOS
    // =========================================================

    match /negocios/{negocioId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && resource.data.propietarioId
                               == request.auth.uid;
    }


    // =========================================================
    // PRODUCTOS
    // =========================================================

    match /negocios/{negocioId}/productos/{productoId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && get(
                         /databases/$(database)/documents/negocios/$(negocioId)
                       ).data.propietarioId
                       == request.auth.uid;

      allow update, delete: if request.auth != null
                            && get(
                                 /databases/$(database)/documents/negocios/$(negocioId)
                               ).data.propietarioId
                               == request.auth.uid;
    }


    // =========================================================
    // PEDIDOS
    // =========================================================

    match /pedidos/{pedidoId} {

      // -------------------------------------------------------
      // CLIENTE CREA SU PEDIDO
      // -------------------------------------------------------

      allow create: if request.auth != null
                    && request.resource.data.usuarioId
                       == request.auth.uid;


      // -------------------------------------------------------
      // LECTURA DE PEDIDOS
      // -------------------------------------------------------

      allow read: if request.auth != null
                  && (
                    resource.data.usuarioId
                    == request.auth.uid

                    ||

                    (
                      resource.data.negocioId != null
                      && get(
                           /databases/$(database)/documents/negocios/$(resource.data.negocioId)
                         ).data.propietarioId
                         == request.auth.uid
                    )
                  );


      // -------------------------------------------------------
      // NEGOCIO CAMBIA ESTADO DEL PEDIDO
      // -------------------------------------------------------

      allow update: if request.auth != null

                    && resource.data.negocioId != null

                    && get(
                         /databases/$(database)/documents/negocios/$(resource.data.negocioId)
                       ).data.propietarioId
                       == request.auth.uid

                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         "estado",
                         "fechaActualizacion"
                       ])

                    && (

                      // Pendiente -> aceptado
                      (
                        resource.data.estado == "pendiente"
                        && request.resource.data.estado == "aceptado"
                      )

                      ||

                      // Pendiente -> cancelado
                      (
                        resource.data.estado == "pendiente"
                        && request.resource.data.estado == "cancelado"
                      )

                      ||

                      // Aceptado -> preparando
                      (
                        resource.data.estado == "aceptado"
                        && request.resource.data.estado == "preparando"
                      )

                      ||

                      // Preparando -> listo
                      (
                        resource.data.estado == "preparando"
                        && request.resource.data.estado == "listo"
                      )

                      ||

                      // Listo -> en_camino
                      (
                        resource.data.estado == "listo"
                        && request.resource.data.estado == "en_camino"
                      )

                      ||

                      // En_camino -> entregado
                      (
                        resource.data.estado == "en_camino"
                        && request.resource.data.estado == "entregado"
                      )
                    );


      // -------------------------------------------------------
      // NO SE PUEDEN BORRAR PEDIDOS
      // -------------------------------------------------------

      allow delete: if false;
    }

    match /solicitudes_delivery/{solicitudId} {

      function solicitudValidaAlCrear() {
        return request.auth != null
               &&
               request.resource.data.clienteId == request.auth.uid
               &&
               request.resource.data.deliveryId != request.auth.uid
               &&
               request.resource.data.estado == "solicitado"
               &&
               request.resource.data.keys().hasAll([
                 "clienteId",
                 "deliveryId",
                 "estado",
                 "origen",
                 "destino",
                 "descripcion",
                 "precioEstimado",
                 "fechaCreacion",
                 "fechaActualizacion"
               ])
               &&
               exists(
                 /databases/$(database)/documents/usuarios/$(request.resource.data.deliveryId)
               )
               &&
               get(
                 /databases/$(database)/documents/usuarios/$(request.resource.data.deliveryId)
               ).data.roles.Delivery == true
               &&
               get(
                 /databases/$(database)/documents/usuarios/$(request.resource.data.deliveryId)
               ).data.delivery.estadoVerificacion == "aprobado"
               &&
               get(
                 /databases/$(database)/documents/usuarios/$(request.resource.data.deliveryId)
               ).data.delivery.activo == true
               &&
               get(
                 /databases/$(database)/documents/usuarios/$(request.resource.data.deliveryId)
               ).data.delivery.disponible == true;
      }

      function transicionDeliveryValida() {
        return
          (
            resource.data.estado == "solicitado"
            &&
            (
              request.resource.data.estado == "aceptado"
              ||
              request.resource.data.estado == "rechazado"
            )
          )
          ||
          (
            resource.data.estado == "aceptado"
            &&
            request.resource.data.estado == "en_camino_recogida"
          )
          ||
          (
            resource.data.estado == "en_camino_recogida"
            &&
            request.resource.data.estado == "recogido"
          )
          ||
          (
            resource.data.estado == "recogido"
            &&
            request.resource.data.estado == "en_camino_destino"
          )
          ||
          (
            resource.data.estado == "en_camino_destino"
            &&
            request.resource.data.estado == "entregado"
          )
          ||
          (
            resource.data.estado == "entregado"
            &&
            request.resource.data.estado == "completado"
          );
      }

      allow create: if solicitudValidaAlCrear();

      allow read: if request.auth != null
                    &&
                    (
                      resource.data.clienteId == request.auth.uid
                      ||
                      resource.data.deliveryId == request.auth.uid
                    );

      allow update: if request.auth != null
                    &&
                    (
                      (
                        resource.data.deliveryId == request.auth.uid
                        &&
                        request.resource.data.deliveryId == resource.data.deliveryId
                        &&
                        request.resource.data.clienteId == resource.data.clienteId
                        &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            "estado",
                            "fechaActualizacion"
                          ])
                        &&
                        transicionDeliveryValida()
                      )
                      ||
                      (
                        resource.data.clienteId == request.auth.uid
                        &&
                        (
                          resource.data.estado == "entregado"
                          ||
                          resource.data.estado == "completado"
                        )
                        &&
                        resource.data.calificacion == null
                        &&
                        request.resource.data.keys().hasAll([
                          "calificacion",
                          "comentarioCalificacion"
                        ])
                        &&
                        request.resource.data.calificacion >= 1
                        &&
                        request.resource.data.calificacion <= 5
                        &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            "calificacion",
                            "comentarioCalificacion",
                            "fechaActualizacion"
                          ])
                      )
                    );

      allow delete: if false;
    }

  }

  match /solicitudes_expreso/{solicitudId} {

    allow create: if request.auth != null
                  && request.resource.data.clienteId == request.auth.uid
                  && request.resource.data.keys().hasAll([
                    "clienteId",
                    "origen",
                    "destino",
                    "pasajeros",
                    "ofertaCliente",
                    "estado",
                    "fechaCreacion",
                    "fechaActualizacion"
                  ])
                  && request.resource.data.estado == "buscando"
                  && request.resource.data.pasajeros >= 1
                  && request.resource.data.ofertaCliente > 0;

    allow read: if request.auth != null
                && (
                  resource.data.clienteId == request.auth.uid
                  ||
                  (
                    resource.data.estado == "buscando"
                    && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.roles.Expreso == true
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.expreso.estadoVerificacion == "aprobado"
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.expreso.activo == true
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.expreso.disponible == true
                  )
                );

    allow update: if request.auth != null
                  && resource.data.clienteId == request.auth.uid
                  && resource.data.estado == "buscando"
                  && request.resource.data.clienteId == resource.data.clienteId
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    "estado",
                    "fechaActualizacion"
                  ])
                  && request.resource.data.estado == "cancelado";

    allow delete: if false;
  }

  // =========================================================
  // CONFIGURACION DE DELIVERY
  // =========================================================
  //
  // Los usuarios autenticados pueden leer las tarifas para
  // calcular el costo de envio.
  //
  // Solo los administradores pueden modificar esta configuracion.
  //

  match /configuracion/delivery {

    allow read: if request.auth != null;

    allow create, update, delete: if isAdmin();
  }
}
}