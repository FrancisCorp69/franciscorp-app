/**
 * =========================================================
 * ADMINISTRACION DELIVERY
 * =========================================================
 */

const {
  onCall,
  HttpsError,
} = require("firebase-functions/v2/https");

async function verificarAdministrador(request) {
  if (!request.auth) {
    throw new HttpsError(
      "unauthenticated",
      "Debes iniciar sesión."
    );
  }

  if (request.auth.token.admin !== true) {
    throw new HttpsError(
      "permission-denied",
      "No autorizado."
    );
  }
}

exports.aprobarSolicitudDelivery = onCall(
  async (request) => {
    await verificarAdministrador(request);

    const deliveryId = request.data?.deliveryId;

    if (
      typeof deliveryId !== "string" ||
      deliveryId.trim() === ""
    ) {
      throw new HttpsError(
        "invalid-argument",
        "deliveryId es obligatorio."
      );
    }

    const ref = db.collection("usuarios").doc(deliveryId);

    const snapshot = await ref.get();

    if (!snapshot.exists) {
      throw new HttpsError(
        "not-found",
        "El usuario Delivery no existe."
      );
    }

    const datos = snapshot.data() || {};
    const delivery = datos.delivery || {};

    if (delivery.estadoVerificacion !== "pendiente") {
      throw new HttpsError(
        "failed-precondition",
        "La solicitud ya no está pendiente."
      );
    }

    const ahora = require("firebase-admin/firestore").FieldValue.serverTimestamp();

    await ref.update({
      "roles.Delivery": true,
      "delivery.estadoVerificacion": "aprobado",
      "delivery.activo": true,
      "delivery.disponible": true,
      "delivery.estado": "aprobado",
      "delivery.solicitud.estado": "aprobado",
      "delivery.solicitud.fechaRevision": ahora,
      "delivery.solicitud.revisadoPor": request.auth.uid,
      fechaActualizacion: ahora,
    });

    console.log(
      "DELIVERY APROBADO:",
      deliveryId,
      "POR:",
      request.auth.uid
    );

    return {
      ok: true,
      mensaje: "Solicitud Delivery aprobada correctamente.",
    };
  }
);

